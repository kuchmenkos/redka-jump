    "id": 6604463,
    "short_id": "vdguju5X",
    "name": "Короткі смерті (до 40k)",
    "description": "Якщо частка до 40k > 55% — Львів / щілина ріжуть занадто рано.",
    "query": {
     "kind": "DataTableNode",
     "source": {
      "connectionId": null,
      "executionTarget": null,
      "explain": null,
      "filters": {
       "breakdownFilter": null,
       "compareFilter": null,
       "dateRange": {
        "date_from": "-30d",
        "date_to": null,
        "daysOfWeek": null,
        "excludeIncompletePeriods": false,
        "explicitDate": false
       },
       "filterTestAccounts": null,
       "interval": null,
       "properties": null
      },
      "kind": "HogQLQuery",
      "modifiers": null,
      "name": null,
      "query": "SELECT\n  countIf(toFloat(properties.score) < 40000) AS `до 40k`,\n  countIf(toFloat(properties.duration_s) < 25) AS `до 25 с`,\n  count() AS `забіги`,\n  round(100 * countIf(toFloat(properties.score) < 40000) / nullIf(count(), 0), 1) AS `частка до 40k`\nFROM events\nWHERE event = 'game_over' AND {filters}",
      "response": null,
      "sendRawQuery": null,
      "tags": null,
      "values": null,
      "variables": null,
      "version": null
