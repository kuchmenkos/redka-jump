       "filterTestAccounts": null,
       "interval": null,
       "properties": null
      },
      "kind": "HogQLQuery",
      "modifiers": null,
      "name": null,
      "query": "SELECT\n  if(event = 'run_abandon', 'вийшов', toString(properties.cause)) AS `чим`,\n  count() AS `скільки`\nFROM events\nWHERE event IN ('game_over', 'run_abandon') AND {filters}\nGROUP BY 1\nORDER BY `скільки` DESC",
