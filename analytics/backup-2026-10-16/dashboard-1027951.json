   "insight": {
    "id": 6604448,
    "short_id": "zcfD9f06",
    "name": "Рахунок і тривалість (p50 / p90)",
    "description": "Дивись медіану. p50 рахунок < 40k — заскладно; > 250k — залегко.",
    "query": {
     "kind": "DataTableNode",
     "source": {
      "connectionId": null,
      "executionTarget": null,
      "explain": null,
      "filters": {
       "breakdownFilter": null,
       "compareFilter": null,
       "dateRange": {
        "date_from": "-30d",
        "date_to": null,
        "daysOfWeek": null,
        "excludeIncompletePeriods": false,
        "explicitDate": false
       },
       "filterTestAccounts": null,
       "interval": null,
       "properties": null
      },
      "kind": "HogQLQuery",
      "modifiers": null,
      "name": null,
      "query": "SELECT\n  round(quantile(0.5)(toFloat(properties.score)), 0) AS `рахунок p50`,\n  round(quantile(0.9)(toFloat(properties.score)), 0) AS `рахунок p90`,\n  round(quantile(0.5)(toFloat(properties.duration_s)), 1) AS `тривалість p50`,\n  round(quantile(0.9)(toFloat(properties.duration_s)), 1) AS `тривалість p90`,\n  count() AS `забіги`\nFROM events\nWHERE event = 'game_over' AND {filters}",
      "response": null,
      "sendRawQuery": null,
      "tags": null,
      "values": null,
      "variables": null,
      "version": null
     }
    },
    "tags": []
